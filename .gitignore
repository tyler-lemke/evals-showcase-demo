# Secrets: API keys live in .env, never commit them.
# .env.example is the template with no real keys, so it stays.
.env
.env.*
!.env.example
*.pem
*.key

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# DeepEval cache and per-run files (results/ is kept so the latest grades are viewable)
.deepeval/
**/results/test_run_*.json
*.lock
!uv.lock

# Node
node_modules/

# OS and editor clutter
.DS_Store
Thumbs.db
.vscode/
.idea/
