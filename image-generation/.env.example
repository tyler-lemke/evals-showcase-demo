# Copy this file to .env and add your key from https://openrouter.ai/keys
# generate.py, promptfoo and DeepEval all read .env from this folder.
OPENROUTER_API_KEY=sk-or-...

# DeepEval saves every run (scores and reasons) as a JSON file in this folder.
DEEPEVAL_RESULTS_FOLDER=results


# promptfoo normally swaps large outputs (the images) for a promptfoo://blob/ link before
# grading, which the judge cannot open. This keeps the image itself in the output.
PROMPTFOO_INLINE_MEDIA=true
