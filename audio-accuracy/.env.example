# Copy this file to .env and add your key from https://openrouter.ai/keys
# transcribe.py, promptfoo and DeepEval all read .env from this folder.
OPENROUTER_API_KEY=sk-or-...

# DeepEval saves every run (scores and reasons) as a JSON file in this folder.
DEEPEVAL_RESULTS_FOLDER=results

# promptfoo runs metrics.py with the `python` on your PATH. Only if it can't find one,
# point it at this folder's Python: .venv/Scripts/python.exe (Windows) or .venv/bin/python
# PROMPTFOO_PYTHON=.venv/bin/python
